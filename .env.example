# Local developer environment.
#
# TWO consumers, neither of which is the application:
#   1. your shell   —  set -a; . ./.env; set +a   (before ./mvnw spring-boot:run / test / flyway:*)
#   2. docker compose — reads ./.env automatically for ${...} interpolation
#
# The app itself no longer reads this file: dotenv-java was removed in Phase 1.
# Copy to .env (gitignored) and fill in. Never commit .env.

# ── Application secrets ──────────────────────────────────────────────────────
JWT_SECRET=                      # >= 32 bytes (HS256)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_KEY=

# ── Local MySQL, dev profile ─────────────────────────────────────────────────
# DB_URL and DB_USERNAME have defaults in application-dev.yaml; DB_PASSWORD
# does not — the app will not start without it.
DB_URL=jdbc:mysql://localhost:3306/store_api?createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=

# ── ./mvnw flyway:info | flyway:migrate | flyway:clean ───────────────────────
# flyway.url / flyway.user have defaults in pom.xml <properties>.
FLYWAY_PASSWORD=

# ── docker compose ───────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=             # becomes DB_PASSWORD inside the app container
MYSQL_HOST_PORT=3307             # host-side port for the mysql service
APP_HOST_PORT=8080
WEBSITE_URL=http://localhost:4242

# ── docs/run-baseline.sh (seed step) ─────────────────────────────────────────
# Point at the compose MySQL instead of a local one:
#   DB_HOST=127.0.0.1 DB_PORT=3307 DB_PASSWORD="$MYSQL_ROOT_PASSWORD" ./docs/run-baseline.sh
